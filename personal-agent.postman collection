                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const url = pm.response.json().url;",
                  "pm.test(\"returns a login url\", () => pm.expect(url).to.include(\"/auth/google/login?code=\"));",
                  "console.log(\"Open this in a BROWSER (works once, expires in 10 min):\", url);"
                ]
