    {
      "name": "4. Google connection",
      "item": [
        {
          "name": "Login (open the URL in a BROWSER)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/auth/google/login?user_id={{user_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "google",
                "login"
              ],
              "query": [
                {
                  "key": "user_id",
                  "value": "{{user_id}}"
                }
              ]
            },
            "description": "Postman shows the redirect target in the Location header. To actually sign in, copy this URL into a browser."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"redirects to Google\", () => pm.expect(pm.response.headers.get(\"Location\")).to.include(\"accounts.google.com\"));"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "followRedirects": false
          }
        },
        {
          "name": "Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/auth/google/status?user_id={{user_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "google",
                "status"
              ],
              "query": [
                {
                  "key": "user_id",
                  "value": "{{user_id}}"
                }
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"connected\", () => pm.expect(pm.response.json().connected).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "Disconnect (revokes + deletes tokens)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/auth/google?user_id={{user_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "google"
              ],
              "query": [
                {
                  "key": "user_id",
                  "value": "{{user_id}}"
                }
              ]
            },
            "description": "Run LAST. You will need to log in again in the browser afterwards."
          }
        }
      ]
